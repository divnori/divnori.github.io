---
layout: default
---
<div class="academic-home">
  <aside class="profile-sidebar" aria-label="Profile and contact">
    {% if page.profile.image %}
      <img class="profile-portrait" src="{{ page.profile.image | prepend: '/assets/img/' | relative_url }}" alt="{{ site.first_name }} {{ site.last_name }}" width="224" height="264">
    {% endif %}
    <h1>{{ site.first_name }} {{ site.last_name }}</h1>
    {% if page.profile.role %}<p class="profile-role">{{ page.profile.role }}</p>{% endif %}
    {% if page.profile.institution %}<p class="profile-institution">{{ page.profile.institution }}</p>{% endif %}
    {% if page.social %}
      <nav class="profile-links" aria-label="Contact and social links">
        {% if site.email %}<a href="mailto:{{ site.email | encode_email }}">Email <span aria-hidden="true">↗</span></a>{% endif %}
        {% if site.scholar_userid %}<a href="https://scholar.google.com/citations?user={{ site.scholar_userid }}">Google Scholar <span aria-hidden="true">↗</span></a>{% endif %}
        {% if site.github_username %}<a href="https://github.com/{{ site.github_username }}">GitHub <span aria-hidden="true">↗</span></a>{% endif %}
        {% if site.x_username %}<a href="https://x.com/{{ site.x_username }}">Twitter <span aria-hidden="true">↗</span></a>{% endif %}
        {% if site.linkedin_username %}<a href="https://www.linkedin.com/in/{{ site.linkedin_username }}">LinkedIn <span aria-hidden="true">↗</span></a>{% endif %}
      </nav>
    {% endif %}
  </aside>

  <div class="home-content">
    <section id="about" class="home-intro" aria-label="About">
      {{ content }}
    </section>

    {% if page.selected_papers %}
      <details id="publications" class="home-section publication-section" open>
        <summary><h2>Publications</h2></summary>
        {% include selected_papers.liquid %}
      </details>
    {% endif %}

    {% if page.news and site.announcements.enabled %}
      <section id="news" class="home-section" aria-labelledby="news-heading">
        <h2 id="news-heading">News</h2>
        <div class="news-columns">
          <div class="news-updates" role="region" aria-label="Recent news" tabindex="0">
            {% include news.liquid limit=true %}
          </div>
          {% include twitter_feed.liquid %}
        </div>
      </section>
    {% endif %}

    {% if site.latest_posts.enabled %}
      <section id="posts" class="home-section" aria-labelledby="posts-heading">
        <h2 id="posts-heading"><a href="{{ '/blog/' | relative_url }}">Latest writing</a></h2>
        {% include latest_posts.liquid %}
      </section>
    {% endif %}
  </div>
</div>
